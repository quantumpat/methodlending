{
  "redirects": [
    {
      "source": "/loan-options",
      "destination": "/loan-programs",
      "statusCode": 301
    },
    {
      "source": "/loan-options/",
      "destination": "/loan-programs",
      "statusCode": 301
    },
    {
      "source": "/privacy",
      "destination": "/privacy-policy",
      "statusCode": 301
    },
    {
      "source": "/privacy/",
      "destination": "/privacy-policy",
      "statusCode": 301
    },
    {
      "source": "/terms",
      "destination": "/terms-of-use",
      "statusCode": 301
    },
    {
      "source": "/terms/",
      "destination": "/terms-of-use",
      "statusCode": 301
    },
    {
      "source": "/terms-of-service",
      "destination": "/terms-of-use",
      "statusCode": 301
    },
    {
      "source": "/terms-of-service/",
      "destination": "/terms-of-use",
      "statusCode": 301
    },
    {
      "source": "/markets",
      "destination": "/markets-served",
      "statusCode": 301
    },
    {
      "source": "/markets/",
      "destination": "/markets-served",
      "statusCode": 301
    }
  ],
  "rewrites": [
    {
      "source": "/purchase(.*)",
      "destination": "/purchase/index.html"
    },
    {
      "source": "/refinance(.*)",
      "destination": "/refinance/index.html"
    },
    {
      "source": "/access-equity(.*)",
      "destination": "/access-equity/index.html"
    },
    {
      "source": "/loan-programs(.*)",
      "destination": "/loan-programs/index.html"
    },
    {
      "source": "/fix-and-flip(.*)",
      "destination": "/fix-and-flip/index.html"
    },
    {
      "source": "/rehab-loans(.*)",
      "destination": "/rehab-loans/index.html"
    },
    {
      "source": "/ground-up-construction(.*)",
      "destination": "/ground-up-construction/index.html"
    },
    {
      "source": "/markets-served(.*)",
      "destination": "/markets-served/index.html"
    },
    {
      "source": "/team(.*)",
      "destination": "/team/index.html"
    },
    {
      "source": "/request-quote(.*)",
      "destination": "/request-quote/index.html"
    },
    {
      "source": "/privacy-policy(.*)",
      "destination": "/privacy-policy/index.html"
    },
    {
      "source": "/terms-of-use(.*)",
      "destination": "/terms-of-use/index.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
